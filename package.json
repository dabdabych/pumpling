{
  "name": "solana-buyer",
  "version": "0.1.0",
  "description": "Off-chain service for buying meme coins on pump.fun and PumpSwap",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:watch": "jest --watch",
    "api": "npm --prefix offchain/api run dev"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@pump-fun/pump-swap-sdk": "^1.19.0",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.0",
    "bs58": "^4.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/pino": "^7.0.4",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
