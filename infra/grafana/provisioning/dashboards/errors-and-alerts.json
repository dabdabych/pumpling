  "panels": [
    {
      "id": 30,
      "title": "Time series",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Purchases / min",
      "description": "Purchases per minute: completed vs abandoned. If abandoned is rising, look at Abandon Breakdown and Retries.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | event=\"purchase.completed\" [1m]))",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | event=~\"purchase.abandoned.*\" [1m]))",
          "legendFormat": "abandoned",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "abandoned"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Errors / min",
      "description": "Error and warn logs per minute. A sharp rise is a sign of a systemic problem. The details are in the Errors & Warnings Log panel.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | level=\"error\" [1m]))",
          "legendFormat": "errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | level=\"warn\" [1m]))",
          "legendFormat": "warnings",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warnings"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Retries / min",
      "description": "Retry attempts per minute: how many started, how many succeeded, how many came through a slippage retry. High retries with low success means RPC or liquidity is degrading.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | event=\"purchase.retry_attempt\" [1m]))",
          "legendFormat": "retry attempts",
          "refId": "A"
        },
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | event=\"purchase.retry_success\" [1m]))",
          "legendFormat": "retry success",
          "refId": "B"
        },
        {
          "expr": "sum(rate({container_name=\"lottery-buyer\"} | json | event=\"purchase.slippage_retry\" [1m]))",
          "legendFormat": "slippage retry",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 22,
      "title": "Abandon Breakdown / min",
      "description": "A breakdown of terminal abandon events: a non-retryable error (insufficient funds and the like), attempts used up, the retry window expired. retry_failed is left out: it is not an abandon but a single failed retry attempt, and a retry_success can follow it.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
