{
  "name": "lottery-offchain-api",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain API wrapper for lottery execution",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "DOTENV_CONFIG_PATH=.env node dist/api/server.js",
    "dev": "DOTENV_CONFIG_PATH=.env ts-node server.ts",
    "api": "npm run dev"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
