{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "./**/*.ts",
    "../orchestrator/**/*.ts",
    "../scheduler/**/*.ts",
    "../solana/**/*.ts",
    "../dex/**/*.ts",
    "../pumpfun/**/*.ts",
    "../buy.ts",
    "../send.ts",
    "../index.ts",
    "../types/**/*.d.ts"
  ],
  "exclude": [
    "../../node_modules",
    "./dist",
    "../pump-buyer",
    "../tests"
  ]
}
