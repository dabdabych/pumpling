# Pumpling: every environment variable the stack reads.
#
# Copy to .env and fill in. Nothing here holds a real value: keys, tokens and
# passwords live only on the machine that runs the stack.
#
# ./deploy.sh            reads .env
# ./deploy.sh .env.dev   reads that file instead, for a devnet stand
#
# Most of these have sensible defaults in code and can be left out. The ones
# marked REQUIRED have none, and the stack will not come up without them.
# DEVNET.md walks through a full devnet round with the values that matter.

# ----------------------------------------------------------------- network

NETWORK=mainnet                                   # mainnet | devnet
SOLANA_HTTP_ENDPOINT=https://api.mainnet-beta.solana.com/
SOLANA_WS_ENDPOINT=wss://api.mainnet-beta.solana.com/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com/
RPC_MAINNET=https://api.mainnet-beta.solana.com/  # the buyer's own endpoint
RPC_DEVNET=https://api.devnet.solana.com
# coin metadata (DAS); optional. HELIUS_API_KEY is also the public RPC
# proxy's first node: on a devnet server it becomes devnet.helius-rpc.com with
# this key, carrying every visitor's wallet calls. To pay for coin pictures and
# nothing else, leave it empty and set HELIUS_DAS_API_KEY, which only the DAS
# lookups read (empty = HELIUS_API_KEY).
HELIUS_API_KEY=
HELIUS_DAS_API_KEY=
HELIUS_DAS_BASE_URL=
# The public RPC proxy and the DAS lookups spend the same Helius plan as the
# buyer. Calls a minute: per client, from everybody together, and DAS lookups
# (10 credits each) from everybody together. Empty = 240, 1200 and 30.
RPC_PROXY_RATE_LIMIT_PER_MINUTE=
RPC_PROXY_GLOBAL_LIMIT_PER_MINUTE=
HELIUS_DAS_LIMIT_PER_MINUTE=
# DAS lookups a UTC day, from everybody together: the most a day can cost is
# this x 10 credits. Empty or 0 = no daily ceiling.
HELIUS_DAS_DAILY_LIMIT=

# Solscan links. Empty means mainnet; a devnet stand needs ?cluster=devnet,
# otherwise every link answers "tx not found".
SOLANA_EXPLORER_QUERY=

# Red flags on a coin, checked once at its first commit in a pool
# (webapp/backend/shared/coin_screening.py). Holders from tracced
# (tracced.xyz, key bound to the server's address), then Solana Tracker's Data
# API. Both optional: without them only what the mint itself shows is flagged.
# COIN_SCREENING_ENABLED=false turns the whole check off on a server: no
# provider is asked and the site shows no mark. Empty = on. Off on mainnet.
COIN_SCREENING_ENABLED=
TRACCED_API_KEY=
SOLANA_TRACKER_API_KEY=
# Calls a day to Solana Tracker, the fallback. Its free plan is 2,500 a month.
# Empty = 75.
SOLANA_TRACKER_DAILY_LIMIT=
# The node the mint is read from. Empty: SOLANA_HTTP_ENDPOINT on mainnet, the
# public mainnet node on a devnet stand, where the coins are mainnet addresses.
COIN_SCREENING_RPC_URL=

# ----------------------------------------------------------------- program

LOTTERY_PROGRAM_ID=4mk8SH9un549ETZatKRkths44e2RBRkFGBmTvFie2oeH
PROGRAM_ID=4mk8SH9un549ETZatKRkths44e2RBRkFGBmTvFie2oeH
PROGRAM_IDL_PATH=workers/idl/lottery.json

# --------------------------------------------------------------- sessions

# REQUIRED. Signs every session token. Generate with `openssl rand -hex 32`.
# The API will not start without it, and will not accept one under 32
# characters. Changing it signs everybody out, which is the way to revoke all
# sessions at once.
JWT_SECRET_KEY=

# ------------------------------------------------------------ the database

POSTGRES_USER=pumpling                            # REQUIRED
# REQUIRED
POSTGRES_PASSWORD=
POSTGRES_DB=pumpling                              # REQUIRED
POSTGRES_PORT=5432
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_DATA_DIR=./pgdata
POSTGRES_LOG_DIR=./logs/postgres
DATABASE_URL=postgresql://pumpling:password@postgres:5432/pumpling   # REQUIRED

# ------------------------------------------------------- round signers

# One signing role. The admin key opens the round, closes deposits, pays ORAO
# for the randomness and starts the buying phase. See workers/CLAUDE.md.
LOTTERY_ADMIN_PUBKEY=
# comma separated, for several admins
LOTTERY_ADMIN_PUBKEYS=
# [64 bytes]; REQUIRED for the phase worker
LOTTERY_ADMIN_SIGNER_KEYPAIR_JSON=
# [[...],[...]] for several admins
LOTTERY_ADMIN_SIGNER_KEYPAIRS_JSON=
# or mount the key as a read-only file
LOTTERY_ADMIN_SIGNER_KEYPAIR_PATH=
LOTTERY_ADMIN_SIGNER_KEYPAIR_PATHS=
# per-admin VRF service routing
LOTTERY_ADMIN_VRF_CONFIG_JSON=
ADMIN_PUBKEY=
ADMIN_PUBKEYS=

# --------------------------------------------------------- the round cycle

LOTTERY_AUTOSTART_ENABLED=true
LOTTERY_AUTOSTART_FEE_BPS=300                     # the platform fee, 3%
# REQUIRED when autostart is on
LOTTERY_AUTOSTART_FEE_WALLET=
# REQUIRED; must differ from the fee wallet
LOTTERY_AUTOSTART_KEEPER_WALLET=
LOTTERY_AUTOSTART_MAX_TOTAL_SOL=111               # the pool cap
# taking commits; empty = 70 minutes
LOTTERY_AUTOSTART_PREDICTION_SECONDS=
LOTTERY_AUTOSTART_GAP_SECONDS=300                 # the "done" pause between rounds
# scripts/vrf_algorithm_hash.py --write fills this
LOTTERY_AUTOSTART_VRF_ALGORITHM_HASH=
# the countdown to launch before the first pool
LOTTERY_HYPE_COUNTDOWN_SECONDS=
# the buying window; empty = 50 minutes, the buyer's BUY_WINDOW_MINUTES
EXECUTION_COUNTDOWN_SECONDS=
PHASE2_CAP_THRESHOLD_SOL=110.95                   # fallback when a round has no cap
START_PURCHASES_DELAY_SECONDS=

# ------------------------------------------------------------- the draw

# Randomness comes from ORAO VRF. There is nothing to configure: the program
# holds their address, asks them by CPI inside the transaction that closes the
# round, and reads their fee and treasury out of their own on-chain config.
# The admin key below pays for it. No oracle service, no separate payer.

PHASE2_AUTOMATION_ENABLED=true
# how often the worker looks, default 1s
PHASE2_POLL_INTERVAL_SECONDS=
# the same for a round already buying, default 15s
POST_VRF_POLL_INTERVAL_SECONDS=
PHASE2_WORKER_LOG_LEVEL=INFO

# ------------------------------------------------------------- the buyer

# REQUIRED; the key of LOTTERY_AUTOSTART_KEEPER_WALLET
KEEPER_SECRET_KEY=
# REQUIRED; the buyer's HTTP API key
API_KEY=
BUYER_API_PORT=3000
OFFCHAIN_API_BASE_URL=http://buyer:3000
# the same value as API_KEY
OFFCHAIN_API_KEY=
OFFCHAIN_API_TIMEOUT_SECONDS=30
PHASE_WORKER_OFFCHAIN_API_TIMEOUT_SECONDS=30
SLIPPAGE_BPS=300
PRIORITIZATION_FEE_LAMPORTS=5000
SEND_TX_RATE_LIMIT=4                              # transactions a second; just under Helius Developer
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_MAX_ACCOUNTS=64
JUPITER_ONLY_DIRECT_ROUTES=0

# Devnet knobs. Unset in production, where the buyer uses an hour of buying and
# ten delivery passes.
BUY_WINDOW_MINUTES=
SEND_ROUNDS=
OVERRIDE_N=
OVERRIDE_SEND_N=

# ------------------------------------------------------------- the workers

WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=
WORKER_RECONNECT_DELAY_SECONDS=
WORKER_RAW_LOG_DEBUG=0
BACKFILL_LOG_LEVEL=INFO
BACKFILL_INTERVAL_SECONDS=
BACKFILL_BATCH_LIMIT=
BACKFILL_MAX_SIGNATURES=
BACKFILL_STATE_ID=
BET_FINALIZER_LOG_LEVEL=INFO
BET_FINALIZER_POLL_INTERVAL_SECONDS=5.0
BET_FINALIZER_BATCH_SIZE=100
BET_FINALIZER_ORPHAN_AFTER_SECONDS=300

# ------------------------------------------------------------- the site

APP_DOMAIN=pumpling.xyz
APP_DOMAIN_ALIASES=
# The state of the public site. Use ./site-mode.sh rather than editing by hand.
#   soon    SITE_ENTRY=index.html       COMING_SOON=true
#           the placeholder on the root: launch date, sign-in, community chat
#   open    SITE_ENTRY=index.html       COMING_SOON=false
#   closed  SITE_ENTRY=coming-soon.html COMING_SOON=false
#           a static page; the app shell is not served at all
SITE_ENTRY=index.html
COMING_SOON=false
PUBLIC_APP_BASE_URL=https://pumpling.xyz
CORS_ORIGINS=https://pumpling.xyz
UI_HTTP_PORT=80
UI_HTTPS_PORT=443
NGINX_CERT_RELOAD_INTERVAL=
# where "how to check this yourself" leads
VERIFY_DOCS_URL=
WALLET_AUTH_DOMAIN=pumpling.xyz
WALLET_AUTH_URI=https://pumpling.xyz
WALLET_AUTH_CHAIN=solana

# ------------------------------------------------------------- email

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pumpling
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
REGISTRATION_EMAIL_SUBJECT=
PASSWORD_RESET_EMAIL_SUBJECT=

# ------------------------------------------------------------- chat

CHAT_MESSAGE_RATE_LIMIT_COUNT=
CHAT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=
CHAT_MESSAGE_HOURLY_LIMIT_COUNT=
CHAT_DUPLICATE_MESSAGE_WINDOW_SECONDS=

# --------------------------------------------------- monitoring and alerts

GRAFANA_PASSWORD=admin
# the alert channel; empty means alerts only go to the log
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_NOTIFICATION_LOG_LEVEL=ERROR
