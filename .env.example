# Pumpling: every environment variable the stack reads.
#
# Copy to .env and fill in. Nothing here holds a real value: keys, tokens and
# passwords live only on the machine that runs the stack.
#
# ./deploy.sh            reads .env
# ./deploy.sh .env.dev   reads that file instead, for a devnet stand
#
# Most of these have sensible defaults in code and can be left out. The ones
# marked REQUIRED have none, and the stack will not come up without them.
# DEVNET.md walks through a full devnet round with the values that matter.

# ----------------------------------------------------------------- network

NETWORK=mainnet                                   # mainnet | devnet
SOLANA_HTTP_ENDPOINT=https://api.mainnet-beta.solana.com/
SOLANA_WS_ENDPOINT=wss://api.mainnet-beta.solana.com/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com/
RPC_MAINNET=https://api.mainnet-beta.solana.com/  # the buyer's own endpoint
RPC_DEVNET=https://api.devnet.solana.com
HELIUS_API_KEY=                                   # coin metadata (DAS); optional
HELIUS_DAS_BASE_URL=

# Solscan links. Empty means mainnet; a devnet stand needs ?cluster=devnet,
# otherwise every link answers "tx not found".
SOLANA_EXPLORER_QUERY=

# ----------------------------------------------------------------- program

LOTTERY_PROGRAM_ID=4mk8SH9un549ETZatKRkths44e2RBRkFGBmTvFie2oeH
PROGRAM_ID=4mk8SH9un549ETZatKRkths44e2RBRkFGBmTvFie2oeH
PROGRAM_IDL_PATH=workers/idl/lottery.json

# ------------------------------------------------------------ the database

POSTGRES_USER=pumpling                            # REQUIRED
POSTGRES_PASSWORD=                                # REQUIRED
POSTGRES_DB=pumpling                              # REQUIRED
POSTGRES_PORT=5432
POSTGRES_PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_DATA_DIR=./pgdata
POSTGRES_LOG_DIR=./logs/postgres
DATABASE_URL=postgresql://pumpling:password@postgres:5432/pumpling   # REQUIRED

# ------------------------------------------------------- round signers

# The round admin and the Switchboard payer are different roles. Do not put the
# Switchboard keypair in as the admin signer. See workers/CLAUDE.md.
LOTTERY_ADMIN_PUBKEY=
LOTTERY_ADMIN_PUBKEYS=                            # comma separated, for several admins
LOTTERY_ADMIN_SIGNER_KEYPAIR_JSON=                # [64 bytes]; REQUIRED for the phase worker
LOTTERY_ADMIN_SIGNER_KEYPAIRS_JSON=               # [[...],[...]] for several admins
LOTTERY_ADMIN_SIGNER_KEYPAIR_PATH=                # or mount the key as a read-only file
LOTTERY_ADMIN_SIGNER_KEYPAIR_PATHS=
LOTTERY_ADMIN_VRF_CONFIG_JSON=                    # per-admin VRF service routing
ADMIN_PUBKEY=
ADMIN_PUBKEYS=

# --------------------------------------------------------- the round cycle

LOTTERY_AUTOSTART_ENABLED=true
LOTTERY_AUTOSTART_FEE_BPS=300                     # the platform fee, 3%
LOTTERY_AUTOSTART_FEE_WALLET=                     # REQUIRED when autostart is on
LOTTERY_AUTOSTART_KEEPER_WALLET=                  # REQUIRED; must differ from the fee wallet
LOTTERY_AUTOSTART_MAX_TOTAL_SOL=111               # the pool cap
LOTTERY_AUTOSTART_PREDICTION_SECONDS=6660         # 111 minutes of taking commits
LOTTERY_AUTOSTART_GAP_SECONDS=300                 # the "done" pause between rounds
LOTTERY_AUTOSTART_VRF_ALGORITHM_HASH=             # scripts/vrf_algorithm_hash.py --write fills this
LOTTERY_HYPE_COUNTDOWN_SECONDS=                   # the countdown to launch before the first pool
EXECUTION_COUNTDOWN_SECONDS=3300                  # 55 minutes of buying
CLOSE_LOTTERY_BUFFER_SECONDS=600                  # close on chain this long before the window ends
PHASE2_CAP_THRESHOLD_SOL=110.95                   # fallback when a round has no cap
START_PURCHASES_DELAY_SECONDS=

# ------------------------------------------------------------- VRF

SWITCHBOARD_SIGNER_KEYPAIR_JSON=dummy             # REQUIRED even for a partial stack
SWITCHBOARD_ON_DEMAND_PROGRAM_ID=
SWITCHBOARD_QUEUE=
SWITCHBOARD_RANDOMNESS_ACCOUNT=
VRF_SERVICE_BASE_URL=http://vrf-service:8787
VRF_SERVICE_PORT=8787
VRF_SERVICE_HOST_PORT=8787
VRF_SERVICE_API_KEY=
VRF_SERVICE_TIMEOUT_SECONDS=30
VRF_REVEAL_MIN_DELAY_SECONDS=
VRF_FALLBACK_ATTEMPTS=
RANDOMNESS_ACCOUNT_READY_POLL_MS=
RANDOMNESS_ACCOUNT_READY_TIMEOUT_MS=
PHASE2_AUTOMATION_ENABLED=true
PHASE2_INITIAL_WAIT_SECONDS=
PHASE2_INITIAL_FULFILL_ATTEMPTS=
PHASE2_INITIAL_FULFILL_WINDOW_SECONDS=
PHASE2_RETRY_WINDOW_SECONDS=
PHASE2_POLL_INTERVAL_SECONDS=
PHASE2_REQUEST_RETRY_INTERVAL_SECONDS=
PHASE2_REQUEST_RETRY_BACKOFF_MAX_SECONDS=
PHASE2_WORKER_LOG_LEVEL=INFO

# ------------------------------------------------------------- the buyer

KEEPER_SECRET_KEY=                                # REQUIRED; the key of LOTTERY_AUTOSTART_KEEPER_WALLET
API_KEY=                                          # REQUIRED; the buyer's HTTP API key
BUYER_API_PORT=3000
OFFCHAIN_API_BASE_URL=http://buyer:3000
OFFCHAIN_API_KEY=                                 # the same value as API_KEY
OFFCHAIN_API_TIMEOUT_SECONDS=30
PHASE_WORKER_OFFCHAIN_API_TIMEOUT_SECONDS=30
SLIPPAGE_BPS=300
PRIORITIZATION_FEE_LAMPORTS=5000
SEND_TX_RATE_LIMIT=4                              # transactions a second; just under Helius Developer
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_MAX_ACCOUNTS=64
JUPITER_ONLY_DIRECT_ROUTES=0

# Devnet knobs. Unset in production, where the buyer uses an hour of buying and
# ten delivery passes.
BUY_WINDOW_MINUTES=
SEND_ROUNDS=
OVERRIDE_N=
OVERRIDE_SEND_N=

# ------------------------------------------------------------- the workers

WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=
WORKER_RECONNECT_DELAY_SECONDS=
WORKER_RAW_LOG_DEBUG=0
BACKFILL_LOG_LEVEL=INFO
BACKFILL_INTERVAL_SECONDS=
BACKFILL_BATCH_LIMIT=
BACKFILL_MAX_SIGNATURES=
BACKFILL_STATE_ID=
BET_FINALIZER_LOG_LEVEL=INFO
BET_FINALIZER_POLL_INTERVAL_SECONDS=5.0
BET_FINALIZER_BATCH_SIZE=100
BET_FINALIZER_ORPHAN_AFTER_SECONDS=300

# ------------------------------------------------------------- the site

APP_DOMAIN=pumpling.xyz
APP_DOMAIN_ALIASES=
PUBLIC_APP_BASE_URL=https://pumpling.xyz
CORS_ORIGINS=https://pumpling.xyz
UI_HTTP_PORT=80
UI_HTTPS_PORT=443
NGINX_CERT_RELOAD_INTERVAL=
VERIFY_DOCS_URL=                                  # where "how to check this yourself" leads
WALLET_AUTH_DOMAIN=pumpling.xyz
WALLET_AUTH_URI=https://pumpling.xyz
WALLET_AUTH_CHAIN=solana

# ------------------------------------------------------------- email

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pumpling
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30
REGISTRATION_EMAIL_SUBJECT=
PASSWORD_RESET_EMAIL_SUBJECT=

# ------------------------------------------------------------- chat

CHAT_MESSAGE_RATE_LIMIT_COUNT=
CHAT_MESSAGE_RATE_LIMIT_WINDOW_SECONDS=
CHAT_MESSAGE_HOURLY_LIMIT_COUNT=
CHAT_DUPLICATE_MESSAGE_WINDOW_SECONDS=

# --------------------------------------------------- monitoring and alerts

GRAFANA_PASSWORD=admin
TELEGRAM_ERROR_BOT_TOKEN=                         # the alert channel; empty means alerts only go to the log
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_NOTIFICATION_LOG_LEVEL=ERROR
